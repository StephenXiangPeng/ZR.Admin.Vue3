# 生产环境配置
NODE_ENV=production

# 应用配置
VITE_APP_TITLE=车房网下单系统
VITE_APP_VERSION=v20240105

# API配置
# 生产环境使用nginx代理，设置为相对路径
VITE_APP_BASE_API=/api
# 如果直接访问后端服务，设置为完整URL
# VITE_APP_BASE_API=http://backend-container:8888

# 后端服务地址（用于nginx代理配置）
VITE_APP_API_HOST=http://backend-container:8888

# 路由配置
VITE_APP_ROUTER_PREFIX=/

# 其他配置
VITE_APP_DEBUG=false
VITE_APP_MOCK=false
